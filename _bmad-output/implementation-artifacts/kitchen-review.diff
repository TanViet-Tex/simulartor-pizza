import type Phaser from 'phaser';

/** Clean artwork only: day/cash/orders and hit targets belong to the scene. */
export const REFERENCE_KITCHEN_MANIFEST = Object.freeze([
  {key:'reference-kitchen-background',url:'assets/reference-kitchen-clean.png',type:'image' as const},
  {key:'reference-kitchen-sprites',url:'assets/reference-kitchen-sprites.png',type:'image' as const},
  {key:'reference-kitchen-ovens',url:'assets/reference-kitchen-ovens.png',type:'image' as const},
  {key:'reference-kitchen-assembly',url:'assets/reference-kitchen-assembly.png',type:'image' as const},
]);

export function registerReferenceKitchenFrames(scene:Phaser.Scene):void {
  const sprites=scene.textures.get('reference-kitchen-sprites');
  const source=sprites.getSourceImage(),w=source.width/4,h=source.height/4;
  const names=['avatar-0','avatar-1','avatar-2','avatar-3','avatar-4','avatar-5',
    'recipe-cheese','recipe-mushroom','recipe-sausage','recipe-pepperoni','recipe-vegetable','recipe-bbq','recipe-seafood','recipe-ham'];
  names.forEach((name,i)=>{if(!sprites.has(name))sprites.add(name,0,Math.round(i%4*w),Math.round(Math.floor(i/4)*h),Math.floor(w),Math.floor(h));});
  for(const [key,names] of [
    ['reference-kitchen-ovens',['oven-empty','oven-occupied','oven-burnt']],
    ['reference-kitchen-assembly',['pizza-base','pizza-sauce','pizza-cheese']],
  ] as const){
    const texture=scene.textures.get(key),source=texture.getSourceImage(),cell=source.width/3;
    names.forEach((name,i)=>{
      // Discard the transparent atlas margins, retaining the art's native proportions.
      const assembly=key==='reference-kitchen-assembly';
      const x=Math.round(i*cell+cell*.035),y=Math.round(source.height*(assembly?.15:.2));
      if(!texture.has(name))texture.add(name,0,x,y,Math.floor(cell*.93),Math.floor(source.height*(assembly?.7:.59)));
    });
  }
}
